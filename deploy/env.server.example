# ============================================================
# summer-checkin —— 服务器上的 .env 模板
# 落地位置：/srv/summer-checkin/.env  （和 docker-compose.yml 同目录）
#
# 【三条规矩，先说清楚】
# 1 这个文件只存在于服务器上，不进 git、不进聊天记录、不截图发人。
#   compose 读它、docker 读它，人不需要反复看它。
# 2 名字带 SECRET / PASSWORD / KEY 的一律"生成"，不要手写"abc123"这种自己记得住的。
#   你记它的唯一场景是数据库密码万一要手敲——所以那条可以抄在自己的密码管理器里。
# 3 改了这里的值不等于容器知道了：
#   environment 变了要 `docker compose up -d`（它会重建受影响的容器），
#   单 `restart` 不会重读 .env。这个区别很常见，先记住。
# ============================================================

# ---- 镜像仓库（这一项不是秘密，公开域名而已；单独放这里是为了换地域/换实例时只改一行）----
# 注意是 **-vpc** 那个：同 VPC 内网拉镜像，不占公网带宽。
# 如果哪天这台机不在 VPC 里了（换轻量/换账号），把它改成去掉 -vpc 的公网域名即可。
ACR_VPC=crpi-898764hxzvvou0jj-vpc.cn-hangzhou.personal.cr.aliyuncs.com

# 拉哪个版本的应用镜像。latest = CI 每次构建都会把它指向最新一次；
# 想固定/回滚就填 7 位 commit 短 sha（Actions 那次的 job summary 里有）。
APP_TAG=latest

# ---- 数据库 ----
# 生成：openssl rand -hex 24
# ⚠️ 用 hex（0-9a-f）而不是 base64：base64 里有 + / = 三个字符，
#    它们出现在 DATABASE_URL 这种连接串里是需要百分号转义的，
#    不转义就会得到"密码明明对却 authentication failed"这种最难查的错。
POSTGRES_PASSWORD=

# ---- 认证与会话 ----
# better-auth 的签名密钥。生成：openssl rand -base64 32
# （它只进 header/cookie 签名，不进 URL，所以 base64 在这里是安全的）
# ⚠️ 换掉这个值 = 所有已登录用户被踢下线，且注册链接里的验证码全失效。
BETTER_AUTH_SECRET=

# 应用对外地址。学习形态填公网 IP:8080；以后上域名 + HTTPS 要改成 https://域名（不带端口）。
# 填错的典型症状：注册/登录接口返回 200，但浏览器里没有 cookie，页面刷一下就掉回登录页。
# ⚠️ 这里故意写占位符而不是真实 IP：这个模板会进公开仓库，
#    把"IP + 项目名"绑在一起写在公网可见的地方，等于替攻击者省了一次侦察。
BETTER_AUTH_URL=http://你的公网IP:8080

# Next.js Server Actions 加密密钥。生成：openssl rand -hex 32
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=

# /api/agent/cron/daily 的 Bearer 口令。生成：openssl rand -hex 16
# 现在用不上（还没接定时任务和 AI），但变量必须留位——
# 代码里读不到它时那条接口是"不设防"的，不是"拒绝服务"。
CRON_SECRET=

# ---- AI（决策③：这一阶段先不接，全部留空）----
# 留空只影响"点 AI 按钮"的那几个功能，登录/打卡/看板照常。
ALIYUN_API_KEY=
EMBEDDING_API_KEY=
DASHSCOPE_API_KEY=
AGNES_API_KEY=
AI_TOKEN_LIMIT=200000

# ---- OSS 对象存储（头像/壁纸直传，先不接就留空）----
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET=
OSS_REGION=
OSS_PUBLIC_BASE_URL=
